<!DOCTYPE html> <html prefix="fb: http://ogp.me/ns/fb" lang="fr"> <head> <meta charset="utf-8" /> <title>Accueil - Arwem</title> <meta name="description" content="" /> <meta name="keywords" content="" /> <meta name="author" content="" /> <meta name="designer" content="" /> <meta name="generator" content="CMS Impulsion" /> <meta name="application-name" content="" /> <meta name="contact" content=""/>   <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />          <link rel="icon" href="/favicon.ico?impv=23d3648cd62aa6d2aab5ed52de981432" type="image/x-icon" /> <link rel="shortcut icon" href="/favicon.ico?impv=23d3648cd62aa6d2aab5ed52de981432" type="image/x-icon" />  <meta name="geo.position" content="" /> <meta name="ICBM" content="" /> <meta name="geo.region" content="BE-WLG" /> <meta name="geo.placename" content="Malmedy" /> <meta name="geo.country" content="Belgium" />  <meta name="google-site-verification" content="" />  <meta name="facebook-domain-verification" content="" /> <meta property="og:title" content="Accueil - Arwem"/> <meta property="og:url" content="https://www.arwem.com/"/> <meta property="og:image" content="https://www.arwem.com"/> <meta property="og:site_name" content="Arwem"/> <meta property="og:type" content="website"/> <meta property="og:description" content="Accueil - Arwem"/> <link rel="alternate" href="https://www.arwem.com/fr/home.htm" hreflang="fr" /><link rel="alternate" href="https://www.arwem.com/nl/home.htm" hreflang="nl" /><link rel="alternate" href="https://www.arwem.com/en/home.htm" hreflang="en" /><link rel="alternate" href="https://www.arwem.com/de/startseite.htm" hreflang="de" /><link rel="alternate" href="https://www.arwem.com/es/inicio.htm" hreflang="es" /><link rel="alternate" href="https://www.arwem.com/pt/inicio.htm" hreflang="pt" /><link rel="alternate" href="https://www.arwem.com/it/home.htm" hreflang="it" /> <link rel="stylesheet" href="/vendors/bootstrap.imp-5.3.3/css/bootstrap.imp.min.css?impv=23d3648cd62aa6d2aab5ed52de981432" type="text/css" media="screen" /><link rel="stylesheet" href="/vendors/fontawesome-6/css/all.min.css?impv=23d3648cd62aa6d2aab5ed52de981432" type="text/css" media="screen" /><link rel="stylesheet" href="/vendors/animate-on-scroll/aos.css?impv=23d3648cd62aa6d2aab5ed52de981432" type="text/css" media="screen" /><link rel="stylesheet" href="/vendors/swiper-11/swiper-bundle.min.css?impv=23d3648cd62aa6d2aab5ed52de981432" type="text/css" media="screen" /><link rel="stylesheet" href="/css/app.css?v=1.3&impv=23d3648cd62aa6d2aab5ed52de981432" type="text/css" media="screen" /><style></style><link rel="preload" href="/fonts/DIN2014-Regular.woff2" as="font" type="font/woff2" crossorigin> <link rel="preload" href="/fonts/URWDINCond-Regular.woff2" as="font" type="font/woff2" crossorigin> <link rel="preload" href="/fonts/URWDINCond-Bold.woff2" as="font" type="font/woff2" crossorigin> <link rel="preload" href="/fonts/URWDINCond-Light.woff2" as="font" type="font/woff2" crossorigin> <link rel="preload" href="/fonts/URWDINCond-DemiItalic.woff2" as="font" type="font/woff2" crossorigin><script type="text/javascript">window.bakery = window.bakery || {debug: false,force_domain: null};(function() {if (window.bakery._loaded) return; window.bakery._loaded = 1;var script = document.createElement('script');script.src = 'https://consent.studio/' + (window.bakery.force_domain || window.location.hostname) + '/banner.js';document.head.appendChild(script);})();</script></head> <body class="" > <div class="fs-overlay-backdrop underlay-drawer header-toggle-el"></div> <div class="fullscreen-menu"> <div class="fs-overlay-backdrop header-toggle-el"></div> <div class="header-close-toggle header-toggle-el"></div> <div class="container-fluid px-0 h-100 position-relative z-index-2 overflow-hidden"> <div class="row g-0 h-100"> <div class="content-col-1 bg-white ms-auto"> <div class="inner"> <ul class="main-nav navbar-nav"> <li class="nav-item"> <a href="#intro" class="nav-link">Intro</a> </li> <li class="nav-item"> <a href="#notre-travail" class="nav-link">Notre travail</a> </li> <li class="nav-item"> <a href="#histoire" class="nav-link">Histoire de la famille</a> </li> <li class="nav-item"> <a href="#histoire-de-l-entreprise" class="nav-link">Histoire de l'entreprise</a> </li> <li class="nav-item"> <a href="#nos-produits" class="nav-link">Nos produits</a> </li> <li class="nav-item"> <a href="#nos-forces" class="nav-link">Nos forces</a> </li> <li class="nav-item"> <a href="#nos-atouts" class="nav-link">Nos atouts</a> </li> <li>&nbsp;</li> <li class="nav-item"> <a href="/fr/contact.htm" class="nav-link">Contact</a> </li> <li class="nav-item"> <a href="/fr/jobs.htm" class="nav-link">Jobs</a> </li> <li class="nav-item"> <a href="/fr/telechargements.htm" class="nav-link">Téléchargements</a> </li> </ul> </div> </div> </div> </div> </div> <div class="header-fixed-offset"></div> <nav class="navbar" id="main-header"> <div class="container"> <a class="navbar-brand" href="/"><img src="/img/logo.svg" height="86" alt="Arwem"></a> <a href="https://www.linkedin.com/company/arwem-food-group/" target="_blank" class="social-media-follow ms-auto me-6 d-none d-sm-block">Follow us on <img src="/img/linkedin-icon.png" class="linkedin-icon" alt="Accueil - Arwem - photo 2"></a> <div class="language-dropdown dropdown me-3 ms-auto ms-sm-0"> <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"> FR </a> <ul class="dropdown-menu"> <li><a class="dropdown-item" href="/fr">FR</a></li> <li><a class="dropdown-item" href="/nl">NL</a></li> <li><a class="dropdown-item" href="/en">EN</a></li> <li><a class="dropdown-item" href="/de">DE</a></li> <li><a class="dropdown-item" href="/es">ES</a></li> <li><a class="dropdown-item" href="/pt">PT</a></li> <li><a class="dropdown-item" href="/it">IT</a></li> </ul> </div> <div class="header-toggle header-toggle-el"> <span class="lines"> <span></span> <span></span> <span></span> </span> </div> </div> </nav> <section id="intro" class="pt-4 py-40px overflow-hidden"> <div class="container"> <div class="banner-boxed"> <div class="bg-img-fill" data-aos="fade-left"><img src="/sites/arwemweb/files/images/banner-image.jpg" alt="Accueil - Arwem - photo 3" /></div> <div class="banner-heading-wrap" data-aos="fade-right"> <h1 class="h1 banner-title main-heading"><span class="fw-light">Une entreprise familiale depuis 3 générations,</span>au service de la qualité alimentaire !</h1> </div> </div> <div class="row gy-5 my-3 my-lg-30px my-xl-5 about-text gx-4 gx-xl-6 gx-xxxl-8 text-center"> <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="100"> <div class="h2 text-count"><span data-counter="" data-target="7">0</span></div> <div class="description"> <p>sociétés de distribution implantées en Europe occidentale</p> </div> </div> <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="200"> <div class="h2 text-count"><span data-counter="" data-target="50">0</span></div> <div class="description"> <p>ans d'expérience dans le secteur du commerce alimentaire</p> </div> </div> <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="300"> <div class="h2 text-count"><span data-counter="" data-target="80">0</span></div> <div class="description"> <p>millions d'euros de chiffre d'affaires cumulé des filiales</p> </div> </div> <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="400"> <div class="h2 text-count"><span data-counter="" data-target="515">0</span></div> <div class="description"> <p>contacts professionnels</p> </div> </div> </div> </div> </section> <section id="notre-travail" class="position-relative z-2 pt-6 pt-lg-6 pt-xxl-8 pb-6 pb-lg-0 bg-light"> <div class="container text-primary"> <div class="row gy-5 gy-lg-0"> <div class="col-lg-6 pb-lg-6 pb-xxl-8 pe-lg-5 pe-xl-6 pe-xxl-7"> <h2 class="h1 main-heading main-heading-2" data-aos="fade-up"><span class="fw-light">Notre activité</span> <br />Tradition, Qualité &amp; Innovation</h2> <div class="mt-40px fs-18px fs-lg-4" data-aos="fade-up" data-aos-delay="100"> <p>Spécialiste de la fabrication, du conditionnement et de l'importation de produits alimentaires, notre société accompagne ses clients avec une offre complète comprenant des produits de panification, de boulangerie, de pâtisserie, des biscuits, des chocolats, des confiseries et une large gamme de snacks.</p> <p>Nous sommes à la recherche constante de produits et spécialités afin d’offrir une grande diversité à nos clients dans leurs points de vente.</p> </div> </div> <div class="col-lg-6 feature-cover-image p-0 overflow-hidden mt-lg-10"> <div class="position-relative overflow-hidden w-100 h-100"> <div class="cover-image-wrap w-100 h-auto"> <div class="ratio ratio-work" data-aos="fade-left" data-aos-delay="100"> <div class="bg-img-fill top-50 translate-middle-y"><img src="/sites/arwemweb/files/images/choco-image.jpg" class="img-fluid" alt="Accueil - Arwem - photo 4" /></div> </div> </div> </div> </div> </div> </div> </section> <section id="histoire" class="position-relative py-9 text-white"> <div class="bg-img-fill"><img src="/sites/arwemweb/files/images/batiment.jpg" class="img-fluid" alt="Batiment" /> <div class="overlay-blue"></div> </div> <div class="container"> <div class="row"> <div class="col-12 text-center text-lg-start" data-aos="fade-up"> <h2 class="h1 main-heading"><span class="fw-light">Une histoire</span> de famille</h2> </div> </div> <div class="row gy-5 mt-1 mt-lg-4 gx-md-5 gx-xl-6 gx-xxxl-7"> <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100"> <h3 class="h2 main-heading">1964</h3> <div class="fs-18px fs-lg-4 story-desc"> <p>Monsieur Constant Van Dyck démarra une activité commerciale dans le domaine des biscuits, pâtisseries industrielles, bonbons et chocolats.</p> </div> </div> <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200"> <h3 class="h2 main-heading mt-lg-40px">1971</h3> <div class="fs-18px fs-lg-4 story-desc"> <p>Probisco International fut la première société de la future holding Arwem Food Group et reste le partenaire stratégique et le coordinateur de différentes entreprises européennes dans le domaine des biscuits, chocolats, bonbons, pains, pâtisseries et snacks.</p> </div> </div> <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300"> <h3 class="h2 main-heading mt-lg-9">1985</h3> <div class="fs-18px fs-lg-4 story-desc"> <p>M. Werner et M. Marc Van Dyck sont les gestionnaires et leurs enfants (Yannick, Dimitri, Julie et Mike) ont également rejoint la société.</p> </div> </div> <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="400"> <h3 class="h2 main-heading mt-lg-13">2008</h3> <div class="fs-18px fs-lg-4 story-desc"> <p>Toutes les activités alimentaires sont intégrées au sein de la holding Arwem Food Group, une société familiale de 3 générations, détenant une expérience significative dans le secteur alimentaire.</p> </div> </div> </div> <div class="text-center mt-5" data-aos="fade-up" data-aos-delay="100"><a href="/fr/histoire1.htm" class="btn btn-outline-light">En savoir plus</a></div> </div> </section> <section id="histoire-de-l-entreprise" class="map-section position-relative py-6 py-lg-8"> <div class="position-absolute w-100 h-100 top-0 start-0 overflow-hidden"> <div class="map-bg bg-img-fill"><img src="/sites/arwemweb/files/images/map-bg-org.png" class="img-fluid" alt="Accueil - Arwem - photo 6" /></div> </div> <div class="container"> <div class="row text-center"> <div class="col-lg-8 mx-auto"> <h2 class="h2 text-primary main-heading" data-aos="fade-up"><span class="fw-light">L'histoire d'une</span> entreprise </h2> <div class="fs-3 text-primary lh-sm mt-4" data-aos="fade-up"> <p>Etudes de marché, visites de magasins, stratégies de vente, développements de produits et d’emballages, contrôles qualités, rencontres avec les unités de production ainsi qu’avec les clients potentiels.</p> </div> </div> </div> <div class="map-areas"><div class="map-logo" data-aos="zoom-in" data-aos-duration="2000"><div class="logo-img"><img src="/sites/arwemweb/files/images/logo.svg" class="img-fluid logo-center" /></div></div><div class="map-item"><div class="img-map-1" data-aos="fade-down" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/arwem-food-distribution.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/arwem-food-distribution.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Arwem Food Distribution UK Ltd</b><br />Palmerston House, Brighton Road 814<br />CR8 2BR Purley, Surrey, United Kingdom<br />VAT: GB 102 4907 49<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-item"><div class="img-map-2" data-aos="fade-down" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/probisco-international.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/probisco-international.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Probisco sprl</b><br />Route G’Haster, 50<br />4950 Ovifat, Belgium<br />VAT: BE 0408 453 439<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-item"><div class="img-map-3" data-aos="fade-right" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/satelitte.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/satelitte.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Satellite sas</b><br />Rue du Colisée, 14<br />75008 Paris, France<br />VAT: FR 343 994 473 33<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-item"><div class="img-map-4" data-aos="fade-left" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/dimi-2.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/dimi-2.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Dimi sa</b><br />Route de G'Haster 50, B-4950 OVIFAT<br />Tel: +32 (0) 80 44 02 40<br />T.V.A.: BE 0446 037 672<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-item"><div class="img-map-5" data-aos="fade-right" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/dimi-dulces-iberica.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/dimi-dulces-iberica.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Dimi Dulces Iberica sl</b><br />Calle Roger de Lluria n°50, 5°<br />08009 Barcelona, Spain<br />VAT: ES B63744668<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-item"><div class="img-map-6" data-aos="fade-left" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/aron-1.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/aron-1.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Aron nv</b><br />Gronsvelderweg, 2<br />6247 ER Gronsveld, The Netherlands<br />VAT: NL 853 438 237 B01<br /><a href="mailto:verkoop@aronbakeries.com">verkoop@aronbakeries.com</a></div></div></div><div class="map-item"><div class="img-map-7" data-aos="fade-up" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/happy-snacks-4.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/happy-snacks-4.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Happy Snacks GmbH</b><br />Grevener Damm 24-26<br />48282 Emsdetten, Germany<br />VAT: DE 811 768 121<br /><a href="mailto:info@happysnacks.de" target="_blank" rel="noopener">info@happysnacks.de</a><br /><a href="https://happysnacks.de" target="_blank" rel="noopener">https://happysnacks.de</a></div></div></div><div class="map-item"><div class="img-map-8" data-aos="fade-up" data-aos-duration="2000"><div class="map-marker"></div><img src="/sites/arwemweb/files/images/logo/arwem_food_distribution_usa_logo.svg" class="img-fluid" /></div><div class="map-tooltip-content"><div class="map-tooltop-logo d-flex justify-content-center"><img src="/sites/arwemweb/files/images/logo/arwem_food_distribution_usa_logo.svg" class="img-fluid" /></div><div class="map-tooltop-details"><b>Arwem Food Distribution USA Ltd</b><br />Palmerston House, Brighton Road 814<br />CR8 2BR Purley, Surrey, United Kingdom<br />VAT: GB 102 4907 49<br /><a href="mailto:afg@arwem.com">afg@arwem.com</a></div></div></div><div class="map-tooltip" role="tooltip" aria-hidden="true"></div></div></div> </section> <section id="nos-produits" class="py-6 py-lg-8"> <div class="container"> <div class="row text-center mb-5 mb-lg-6"> <div class="col" data-aos="fade-up"> <h2 class="h2 main-heading text-primary"><span class="fw-light">Nos</span> PRODUiTS</h2> </div> </div> <div class="row"> <div class="position-relative"> <div class="swiper productSwiper"> <div class="swiper-wrapper"><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/biscuits.png" class="img-fluid" alt=""> </div><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/rice_cake_logo.png" class="img-fluid" alt=""> </div><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/chocolat_logo.png" class="img-fluid" alt=""> </div><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/salted-aperitif_snack.png" class="img-fluid" alt=""> </div><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/caring_food2.png" class="img-fluid" alt=""> </div><div class="swiper-slide"> <img src="/sites/arwemweb/files/images/products/bars.svg" class="img-fluid" alt=""> </div></div> </div> <div class="swiper-button-next product-button-arrow"></div> <div class="swiper-button-prev product-button-arrow"></div> </div> </div> </div> </section> <section id="nos-forces" class="py-6 py-lg-8 bg-primary"> <div class="container text-white text-center"> <div class="row pb-5"> <div class="col" data-aos="fade-up"> <h2 class="h1 main-heading"><span class="fw-light">Nos</span> FORCES</h2> </div> </div> <div class="row gx-lg-4 align-items-stretch gy-40px"> <div class="col-lg-4 certification-text"> <div class="d-flex flex-column justify-content-center border px-xxl-3 py-40px h-100"> <div class="pb-5" data-aos="fade-up" data-aos-delay="100"> <div class="img-size-5 mb-4"><img src="/sites/arwemweb/files/images/certification.png" class="img-fluid" alt="Accueil - Arwem - photo 21" /></div> <h3 class="h4 widget-title">Certificats</h3> </div> <div class="pb-5" data-aos="fade-up" data-aos-delay="200"> <div class="img-size-5 mb-4"><img src="/sites/arwemweb/files/images/ifs-broker.png" class="img-fluid" alt="Accueil - Arwem - photo 22" /></div> <div class="desc"> <p>Nos certifications IFS Broker garantissent la sécurité et la qualité de nos produits. En 2014, nous avons été certifiés pour notre première filiale.</p> </div> </div> <div class="pb-0" data-aos="fade-up" data-aos-delay="300"> <div class="img-size-5 mb-4"><img src="/sites/arwemweb/files/images/organic-brand.png" class="img-fluid" alt="Accueil - Arwem - photo 23" /></div> <div class="desc"> <p>Grâce à nos certifications biologiques, nous pouvons proposer des produits issus de l’agriculture biologique. En 2008, nous avons été certifiés pour notre première filiale.</p> </div> </div> </div> </div> <div class="col-lg-8"> <div class="row gx-4 gy-40px gy-lg-4"> <div class="col-md-6" data-aos="fade-up" data-aos-delay="100"> <div class="widget-box border"> <div class="widget-wrap"> <div class="widget-content"> <div class="img-wrap img-size-2 mb-4"><img src="/sites/arwemweb/files/images/shake-hands.png" class="img-fluid" alt="Accueil - Arwem - photo 24" /></div> <h3 class="h4 widget-title">Relations</h3> <div class="mt-4"> <p>Depuis plusieurs années, AFG a de solides relations avec les détaillants et discounters en Europe.</p> </div> </div> </div> </div> </div> <div class="col-md-6" data-aos="fade-up" data-aos-delay="200"> <div class="widget-box border"> <div class="widget-wrap"> <div class="widget-content"> <div class="img-wrap img-size-3 mb-20px"><img src="/sites/arwemweb/files/images/temperature.png" class="img-fluid" alt="Accueil - Arwem - photo 25" /></div> <h3 class="h4 widget-title">Produits à température ambiante et surgelés</h3> <div class="mt-4"> <p>La plupart des produits du groupe AFG sont stockés en rayons et vendus à température ambiante. Les dernières années, AFG a également commencé à vendre des produits surgelés.</p> </div> </div> </div> </div> </div> <div class="col-md-6" data-aos="fade-up" data-aos-delay="300"> <div class="widget-box border"> <div class="widget-wrap"> <div class="widget-content"> <div class="img-wrap img-size-4 mb-4"><img src="/sites/arwemweb/files/images/exporting-box.png" class="img-fluid" alt="Accueil - Arwem - photo 26" /></div> <h3 class="h4 widget-title">Exportation</h3> <div class="mt-4"> <p>AFG exporte également des produits en dehors de l’Europe via son réseau international.</p> </div> </div> </div> </div> </div> <div class="col-md-6" data-aos="fade-up" data-aos-delay="400"> <div class="widget-box border"> <div class="widget-wrap"> <div class="widget-content"> <div class="img-wrap"><img src="/sites/arwemweb/files/images/retail.png" class="img-fluid custom-img-2 pb-2" alt="Accueil - Arwem - photo 27" /></div> <h3 class="h4 widget-title">Vente au détail et restauration</h3> <div class="mt-4"> <p>AFG ne se contente pas de traiter avec ses revendeurs et distributeurs, elle est également très active dans le secteur Out of Home (collectivités, distributeurs automatiques, stations essences, etc.)</p> </div> </div> </div> </div> </div> </div> </div> </div> </div> </section> <section id="nos-atouts" class="py-6 py-lg-8 bg-light-gray"> <div class="container"> <div class="row text-center text-primary"> <div class="col"> <h2 class="h1 main-heading main-heading-2 pb-3" data-aos="fade-up">Nos atouts<br /><span class="fw-light">au service de nos partenaires</span></h2> <div class="mt-4 mb-5 mb-lg-7" data-aos="fade-up"> <div class="ww-distribution-img"><img src="/sites/arwemweb/files/images/icons/worldwide-distribution.svg" class="img-fluid" alt="Accueil - Arwem - photo 28" /></div> <h3 class="h3 text-uppercase text-primary-light">Distribution dans le monde entier<br /><span class="fw-light text-lowercase text-primary">via un réseau international.</span></h3> </div> </div> </div> <div class="row list-advantages g-0 gy-6 text-center"> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="100"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-product-knowledge.png" class="img-fluid" alt="Accueil - Arwem - photo 29" /> <h3 class="h3 item-title">Connaissance des produits</h3> <div class="advantages-text"> <p>biscuits, chocolats, bonbons, pains et subsituts, pâtisseries et snacks.</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="200"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-marketing.png" class="img-fluid" alt="Accueil - Arwem - photo 30" /> <h3 class="h3 item-title">Connaissance du marché / Tests de panel</h3> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="300"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-logistic.png" class="img-fluid" alt="Accueil - Arwem - photo 31" /> <h3 class="h3 item-title">Avantage logistique pour le fournisseur</h3> <div class="advantages-text"> <p>1 seul entrepôt central par pays</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="400"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-sales-marketing.png" class="img-fluid" alt="Accueil - Arwem - photo 32" /> <h3 class="h3 item-title">Conseils en vente et marketing</h3> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="100"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-quality-service.png" class="img-fluid" alt="Accueil - Arwem - photo 33" /> <h3 class="h3 item-title">Services de qualité</h3> <div class="advantages-text"> <p>(approbation des fabricants, respect des exigences du client, expertise en matière de réglementation alimentaire, contrôle des étiquetages)</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="200"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-registered-supplier.png" class="img-fluid" alt="Accueil - Arwem - photo 34" /> <h3 class="h3 item-title">Enregistré en tant que fournisseur</h3> <div class="advantages-text"> <p>auprès de la plupart des distributeurs européens</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="300"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-logistic-robot.png" class="img-fluid" alt="Accueil - Arwem - photo 35" /> <h3 class="h3 item-title">Avantage logistique pour le client</h3> <div class="advantages-text"> <p>gestion des stocks, enlèvements,…</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="400"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-creation-dev.png" class="img-fluid" alt="Accueil - Arwem - photo 36" /> <h3 class="h3 item-title">Création et développement</h3> <div class="advantages-text"> <p>d’emballages spécifiques et produits sur mesure</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="100"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-quality-standards.png" class="img-fluid" alt="Accueil - Arwem - photo 37" /> <h3 class="h3 item-title">Normes de qualité élevées</h3> <div class="advantages-text"> <p>(normes internationales de reconnaissance de la qualité et de la sécurité alimentaire, procédures d'hygiène et de sécurité alimentaire, matières premières durables certifiées)</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="200"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-local-staff.png" class="img-fluid" alt="Accueil - Arwem - photo 38" /> <h3 class="h3 item-title">Personnel local</h3> <div class="advantages-text"> <p>ou dédié à nos clients</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="300"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-several-languages.png" class="img-fluid" alt="Accueil - Arwem - photo 39" /> <h3 class="h3 item-title">Plusieurs langues</h3> <div class="advantages-text"> <p>parlées au sein de la société : FR, NL, DE, ES, IT, EN..</p> </div> </div> </div> <div class="item-advantage col-md-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="400"> <div class="advantage-content"><img src="/sites/arwemweb/files/images/icon-market-studies.png" class="img-fluid" alt="Accueil - Arwem - photo 40" /> <h3 class="h3 item-title">Etudes de marché rapides</h3> <div class="advantages-text"> <p>(prix et recettes)</p> </div> </div> </div> </div> </div> </section> <section class="position-relative"> <div class="bg-img-fill"><img src="/sites/arwemweb/files/images/contact-bg.jpg" class="img-fluid" alt="Accueil - Arwem - photo 41" /></div> <div class="container-fluid"> <div class="row"> <div class="col-lg-auto contact-underlay"> <div class="contact-info" data-aos="fade-up" data-aos-delay="100"> <h2 class="h1 main-heading main-heading-2 text-uppercase text-primary mb-40px mb-lg-40px mb-xxl-5"><span class="fw-light">Notre</span> Siège social</h2> <div class="sub-heading ff-URW-italic text-primary-light mb-4 mb-lg-30px"> <p>Situés à proximité du point culminant de Belgique, nous serions ravis de vous accueillir dans nos bureaux.</p> </div> <div class="address ff-URW mb-4 mb-lg-30px"> <p>Arwem House <br />Route de G’Hâstêr, 50 <br />4950 Ovifat, BELGIQUE <br /><a href="tel:+32 (0) 80 44 02 60">+32 (0) 80 44 02 60</a></p> </div> <ul class="list-unstyled external-links mb-40px mb-lg-5"> <li><a href="https://www.google.com/maps/d/u/0/edit?mid=1Lh8fNKXDTZ1htwbQ3eSjEnhqjNZC90k&amp;usp=sharing" class="external-link" target="_blank" rel="noopener">Voir le plan d’accès sur Google Maps</a></li> </ul> <a href="/fr/contact.htm" class="btn btn-primary">Contactez-nous</a></div> </div> </div> </div> </section><footer id="footer" class="bg-primary text-white py-30px py-lg-4"> <div class="container-fluid px-lg-5 px-xxl-9"> <div class="row gy-20px align-items-center"> <div class="col-12 col-lg-auto text-center text-lg-start"> <p>© Arwem Food Group 11/2026</p> </div> <div class="col-12 col-lg-auto mx-auto"> <ul class="nav footer-links row-gap-2 gap-20px gap-sm-40px gap-lg-5 justify-content-center"> <li class="nav-item"> <a href="/fr/informations/politique-de-cookies.htm" class="nav-link">Politique de cookies</a> </li> <li class="nav-item"> <a href="/fr/informations/politique-de-confidentialite.htm" class="nav-link">Politique de confidentialité</a> </li> <li class="nav-item"> <a href="/fr/informations/conditions-generales.htm" class="nav-link">Conditions générales</a> </li> <li class="nav-item"> <a href="/fr/informations/contact1.htm" class="nav-link">Contact</a> </li> </ul> </div> <div class="col-12 col-lg-auto text-center text-lg-end"> <div class="footer-logo"> <a href="https://art-east.be/" target="_blank"><img src="/img/arteast-logo.png" class="img-fluid" alt="Accueil - Arwem - photo 42" /></a> </div> </div> </div> </div> </footer> <script type="text/javascript" src="/vendors/jquery/jquery.min.js?impv=23d3648cd62aa6d2aab5ed52de981432"></script><script type="text/javascript" src="/vendors/bootstrap.imp-5.3.3/js/bootstrap.bundle.imp.min.js?impv=23d3648cd62aa6d2aab5ed52de981432"></script><script type="text/javascript" src="/vendors/swiper-11/swiper-bundle.min.js?impv=23d3648cd62aa6d2aab5ed52de981432"></script><script type="text/javascript" src="/vendors/animate-on-scroll/aos.js?impv=23d3648cd62aa6d2aab5ed52de981432"></script><script type="text/javascript" src="/js/app.js?v=1.2&impv=23d3648cd62aa6d2aab5ed52de981432"></script><script type="text/javascript" src="https://cdn.impulsion.be/js/impRecaptcha.js?impv=23d3648cd62aa6d2aab5ed52de981432"></script></body> </html>