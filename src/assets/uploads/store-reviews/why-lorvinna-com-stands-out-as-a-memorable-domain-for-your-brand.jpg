      font-weight="600" fill="#86efac" letter-spacing="4">PREMIUM DOMAIN · FOR SALE</text>
    <text x="600" y="352" text-anchor="middle" font-family="Inter, system-ui, sans-serif"
      font-size="92" font-weight="800" fill="#ffffff" letter-spacing="-2">
      lorvinna.com
    </text>

    <text x="600" y="412" text-anchor="middle" font-family="Inter, system-ui, sans-serif"
      font-size="34" font-weight="700" fill="#22c55e">$195 USD</text>
  </g>


  
