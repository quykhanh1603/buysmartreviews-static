<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if tags and 'post' in tags %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{% if image %}{{ image }}{% else %}/assets/brand/logo-mark.png{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<meta name='impact-site-verification' value='fc54a462-d8c0-47f4-8d08-8476dc0b1a45'>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
{% if jsonLd %}
<script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
{% endif %}
{% if site.gaId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}');
</script>
{% endif %}
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo"><img src="/assets/brand/logo-mark.png" alt="" class="logo-mark" width="32" height="32">Buy Smart<span class="dot">.</span> Reviews</a>
    <nav class="nav-links">
      <a href="/#categories">Categories</a>
      <a href="/how-we-review-products/">How We Review</a>
      <a href="/about-buy-smart-reviews/">About</a>
      <a href="/search/">Search</a>
      <a href="/contact-us/">Contact</a>
    </nav>
  </div>
</header>

<main data-pagefind-body>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <span class="logo"><img src="/assets/brand/logo-mark.png" alt="" class="logo-mark" width="32" height="32">Buy Smart<span class="dot">.</span> Reviews</span>
      <div class="footer-links">
        <a href="/about-buy-smart-reviews/">About</a>
        <a href="/how-we-review-products/">How We Review</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/contact-us/">Contact</a>
      </div>
    </div>
    <p class="disclaimer">
      Buy Smart Reviews is reader-supported and displays advertising, including Google-served ads, to
      cover research and operating costs. Advertising does not influence which businesses we choose to
      cover or how we rate them. Many articles include affiliate links to the business being reviewed —
      we may earn a commission on purchases made through those links, at no extra cost to you. This is
      disclosed on every article that includes one, and it does not affect our evaluation criteria.
    </p>
    <p class="copyright">&copy; {{ currentYear }} Buy Smart Reviews. Independent research, not an official representative of any business reviewed.</p>
  </div>
</footer>

<script src="/pagefind/pagefind-ui.js"></script>
</body>
</html>
